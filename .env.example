# ============================================================
# Siva Sai Seeds — Environment Variables Template
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to Git.
# ============================================================

# ── Supabase (Vite — used by the React app) ───────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase (Server-side / ops scripts only) ─────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here   # KEEP SECRET — never expose client-side

# ── Database (ops scripts only) ───────────────────────────
DATABASE_URL=your-database-connection-string-here
