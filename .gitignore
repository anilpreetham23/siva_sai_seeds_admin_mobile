# ============================================================
# Siva Sai Seeds — React/Vite + Capacitor Mobile App
# .gitignore — never commit secrets or build artifacts
# ============================================================

# ── Secrets & Environment ──────────────────────────────────
.env
.env.*
!.env.example

# ── Node ──────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Build Outputs ─────────────────────────────────────────
dist/
dist-ssr/
build/
*.local

# ── Android Build Artifacts ───────────────────────────────
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/captures/
*.apk
*.aab
*.keystore
!debug.keystore

# ── iOS Build Artifacts ────────────────────────────────────
ios/App/build/
ios/App/Pods/
ios/App/DerivedData/
ios/.xcode.env.local
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# ── Capacitor ─────────────────────────────────────────────
android/app/src/main/assets/public/
ios/App/App/public/

# ── IDE ───────────────────────────────────────────────────
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ── Misc ──────────────────────────────────────────────────
*.log
*.tmp
coverage/
.cache/
